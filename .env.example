# TASTY TAP - Environment Configuration
# Copy this file to .env and update values for production

SECRET_KEY=django-insecure-tasty-tap-dev-secret-key-change-in-production-987654321
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# Database Configuration (defaults to SQLite if not set)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# Payment Gateway (Mock mode enabled for development; configure for Razorpay/Stripe in production)
PAYMENT_GATEWAY_MODE=mock
RAZORPAY_KEY_ID=rzp_test_placeholder_do_not_expose
RAZORPAY_KEY_SECRET=placeholder_secret

# AI & Recommendation Engine
AI_PROVIDER=local_hybrid
OPENAI_API_KEY=

# Maps & Geolocation Engine (Built-in Tasty Tap Tile Proxy + Multi-Provider Key)
MAPS_PROVIDER=tasty_tap_tile_engine
MAPS_API_KEY=tt_maps_live_9f8a7b6c5d4e3f2a1b0c9d8e7f6a5b4c

# Platform Settings
DEFAULT_JOINING_FEE=0
PLATFORM_COMMISSION_PERCENT=0
DEFAULT_DELIVERY_FEE=25
FREE_DELIVERY_THRESHOLD=199
TASTY_POINTS_PER_100_INR=10

